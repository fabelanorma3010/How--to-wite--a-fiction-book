# Copy to .env.local and fill in. Features whose variables are missing degrade
# gracefully.

# --- Supabase (auth + database) ------------------------------------------
# Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_… or the legacy anon JWT). Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_… or the legacy service_role JWT). Server-only, bypasses
# Row Level Security — never expose to the browser. Required for /admin.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the deployed site, e.g. https://www.fiction-book-builder.com
# Used to build the OAuth / email-link redirect back to /auth/callback. Optional
# locally (falls back to the request origin); set it in production so links land
# on the right host behind Cloudflare.
NEXT_PUBLIC_SITE_URL=

# "Continue with Google": the Google OAuth client ID + secret are configured in
# the Supabase dashboard (Authentication > Providers > Google), NOT here. See
# README "Google sign-in". For the local Supabase stack only, put them in
# supabase/.env as SUPABASE_AUTH_GOOGLE_CLIENT_ID / SUPABASE_AUTH_GOOGLE_SECRET.

# --- Admin (/admin) ------------------------------------------------------
# Comma-separated emails allowed into /admin. Each must also have a Supabase
# Auth account (via password or Google). Everyone else is bounced to /admin/login.
ADMIN_EMAILS=

# --- AI features ----------------------------------------------------------
# The Fiction Helper chat, Illustration Generator, and /tools writing tools all
# prefer Google Gemini when GEMINI_API_KEY is set, and fall back to Anthropic
# (text) / OpenAI (images) otherwise. Get a free Gemini key at
# https://aistudio.google.com (no billing needed) — see README "AI features".
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional. Salt for the anonymous-visitor IP hash used by the AI daily limits
# (src/lib/aiLimits.ts). Any stable string; defaults to a built-in value.
AI_LIMIT_SALT=

# --- Umami analytics -------------------------------------------------------
# Sign up at https://cloud.umami.is (free), add this site, and copy the
# "Website ID" it gives you (a UUID) — see README "Umami analytics". Leave
# blank to disable tracking entirely (nothing is rendered without it).
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# Only needed if self-hosting Umami or your Umami Cloud script URL differs
# from the default. Leave blank to use https://cloud.umami.is/script.js.
NEXT_PUBLIC_UMAMI_SRC=
