# Copy to .env.local and fill in. Features whose variables are missing degrade
# gracefully.

# --- Supabase (auth + database) ------------------------------------------
# Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_… or the legacy anon JWT). Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_… or the legacy service_role JWT). Server-only, bypasses
# Row Level Security — never expose to the browser. Required for /admin.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of the deployed site, e.g. https://www.fiction-book-builder.com
# Used to build the OAuth / email-link redirect back to /auth/callback. Optional
# locally (falls back to the request origin); set it in production so links land
# on the right host behind Cloudflare.
NEXT_PUBLIC_SITE_URL=

# "Continue with Google": the Google OAuth client ID + secret are configured in
# the Supabase dashboard (Authentication > Providers > Google), NOT here. See
# README "Google sign-in". For the local Supabase stack only, put them in
# supabase/.env as SUPABASE_AUTH_GOOGLE_CLIENT_ID / SUPABASE_AUTH_GOOGLE_SECRET.

# --- Admin (/admin) ------------------------------------------------------
# Comma-separated emails allowed into /admin. Each must also have a Supabase
# Auth account (via password or Google). Everyone else is bounced to /admin/login.
ADMIN_EMAILS=

# --- AI features ----------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
