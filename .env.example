# Copy to .env.local and fill in. All values are optional — features whose
# variables are missing degrade gracefully (see the API routes).

# --- Turso (current auth + community wall) ---------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Supabase (membership / community schema in supabase/migrations) -------
# Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_… or the legacy anon JWT). Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_… or the legacy service_role JWT). Server-only, bypasses
# Row Level Security — never expose to the browser. Required for /admin.
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin (/admin) ------------------------------------------------------
# Comma-separated emails allowed into /admin. Each must also have a Supabase
# Auth account. Everyone else is bounced to /admin/login.
ADMIN_EMAILS=

# --- AI features ----------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
